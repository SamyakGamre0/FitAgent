<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏱ Rest Timer"
        android:textColor="@color/aura_green"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tv_rest_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="60"
        android:textColor="@color/text_primary"
        android:textSize="72sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="seconds"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_minus_15"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="-15s"
            android:textColor="@color/aura_green"
            app:backgroundTint="@color/bg_elevated"
            app:cornerRadius="12dp"
            android:layout_marginEnd="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_plus_15"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="+15s"
            android:textColor="@color/aura_green"
            app:backgroundTint="@color/bg_elevated"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel_rest"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Skip Rest"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:backgroundTint="@color/aura_green"
        app:cornerRadius="12dp"
        android:layout_marginTop="24dp" />
</LinearLayout>
